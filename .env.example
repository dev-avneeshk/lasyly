# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe (required for payments) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Site URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ─── Cron Jobs ────────────────────────────────────────────────────────────────
CRON_SECRET=generate-a-random-32-char-string

# ─── Guest sessions ───────────────────────────────────────────────────────────
# HMAC key used to sign the lasyly_guest cookie issued by /api/auth/guest.
# Must be at least 32 characters of high-entropy randomness. If unset, all
# guest-cookie verifications fail (existing guests are forced to log in).
GUEST_TOKEN_SECRET=generate-a-random-32-char-string

# ─── Optional: AI Features ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Optional: YouTube Highlights ─────────────────────────────────────────────
YOUTUBE_API_KEY=AIza...

# ─── Optional: Sports Data ────────────────────────────────────────────────────
SPORTS_API_KEY=your-api-sports-key

# ─── IndexNow (Bing / DuckDuckGo / Yahoo instant indexing) ──────────────────
# Get a free key at: https://www.bing.com/indexnow/getstarted
# Then create public/<your-key>.txt containing just the key string.
INDEXNOW_KEY=your-indexnow-key

# ─── Optional: Error Tracking (Sentry) ───────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
SENTRY_AUTH_TOKEN=sntrys_...

# ─── Rate Limiting (Upstash Redis — required for production) ─────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ─── Web Push Notifications (VAPID) ──────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@lasyly.me

# ─── Chat realtime delivery ──────────────────────────────────────────────────
# Chat is broadcast-only by default: the messages API route broadcasts each
# message server-side in the same request that inserts it, and clients re-read
# recent history on every (re)subscribe. That combination is what makes delivery
# reliable without a `postgres_changes` subscription.
#
# Setting this to "true" additionally subscribes to postgres_changes on
# public.messages. It is OFF by default because Supabase Realtime evaluates the
# row filter AND the table's RLS policy (can_view_subchannel — 2-3 index
# lookups) once per subscriber per row, so one message in a room with N viewers
# costs ~2-3N lookups inside Realtime. Only turn it on to diagnose a suspected
# delivery gap.
NEXT_PUBLIC_CHAT_PG_CHANGES=false
